 "transcript_turns": [
  {
   "session_id": "00000000-0000-4000-8000-00000000d001",
   "turn_id": "tt-01",
   "role": "user",
   "text_redacted": "Okay, die erste Rechnung ist von Präzisionswerk Ulm, eine CNC-Vorrichtung für 6.350 Euro.",
   "lang": "de",
   "t_ms": 8000,
   "off_record": false
  },
  {
   "session_id": "00000000-0000-4000-8000-00000000d001",
   "turn_id": "tt-02",
   "role": "user",
   "text_redacted": "Den Lieferanten kenne ich, der ist in der Lieferantenliste.",
   "lang": "de",
   "t_ms": 16000,
   "off_record": false
  },
  {
   "session_id": "00000000-0000-4000-8000-00000000d001",
   "turn_id": "tt-03",
   "role": "user",
   "text_redacted": "Das ist eine Maschine über 5.000 Euro, das ist Anlagevermögen. Das geht immer auf 0400, nie auf 4711.",
   "lang": "de",
   "t_ms": 24000,
   "off_record": false
  },
  {
   "session_id": "00000000-0000-4000-8000-00000000d001",
   "turn_id": "tt-20",
   "role": "agent",
   "text_redacted": "Warum ändern Sie die Kostenstelle von 4711 auf 0400?",
   "lang": "de",
   "t_ms": 27000,
   "off_record": false
  },
  {
   "session_id": "00000000-0000-4000-8000-00000000d001",
   "turn_id": "tt-04",
   "role": "user",
   "text_redacted": "Alles, was Ausrüstung ist und über 5.000 Euro netto kostet, ist Capex. 4711 ist nur für laufende Kosten.",
   "lang": "de",
   "t_ms": 30000,
   "off_record": false
  },
  {
   "session_id": "00000000-0000-4000-8000-00000000d001",
   "turn_id": "tt-05",
   "role": "user",
   "text_redacted": "Und ohne Anlagennummer darf ich nicht auf 0400 buchen, das lehnt die Buchhaltung ab.",
   "lang": "de",
   "t_ms": 38000,
   "off_record": false
  },
  {
   "session_id": "00000000-0000-4000-8000-00000000d001",
   "turn_id": "tt-06",
   "role": "user",
   "text_redacted": "Kranbau, Dezember. Da muss ich aufpassen.",
   "lang": "de",
   "t_ms": 63000,
   "off_record": false
  },
  {
   "session_id": "00000000-0000-4000-8000-00000000d001",
   "turn_id": "tt-21",
   "role": "agent",
   "text_redacted": "Warum setzen Sie die Rechnung von Kranbau auf Halt?",
   "lang": "de",
   "t_ms": 72000,
   "off_record": false
  },
  {
   "session_id": "00000000-0000-4000-8000-00000000d001",
   "turn_id": "tt-07",
   "role": "user",
   "text_redacted": "Kranbau hat uns letztes Jahr im Dezember doppelt abgerechnet. Seitdem halte ich jede Dezemberrechnung von denen an und prüfe erst auf Duplikate.",
   "lang": "de",
   "t_ms": 75000,
   "off_record": false
  },
  {
   "session_id": "00000000-0000-4000-8000-00000000d001",
   "turn_id": "tt-08",
   "role": "user",
   "text_redacted": "Die ist von der tschechischen Tochter, CZ01.",
   "lang": "de",
   "t_ms": 98000,
   "off_record": false
  },
  {
   "session_id": "00000000-0000-4000-8000-00000000d001",
   "turn_id": "tt-22",
   "role": "agent",
   "text_redacted": "Gilt das für alle CZ-Rechnungen, unabhängig vom Betrag?",
   "lang": "de",
   "t_ms": 106000,
   "off_record": false
  },
  {
   "session_id": "00000000-0000-4000-8000-00000000d001",
   "turn_id": "tt-09",
   "role": "user",
   "text_redacted": "Ja, bei CZ01 brauchen wir immer eine zweite Freigabe, egal wie hoch der Betrag ist.",
   "lang": "de",
   "t_ms": 110000,
   "off_record": false
  },
  {
   "session_id": "00000000-0000-4000-8000-00000000d001",
   "turn_id": "tt-10",
   "role": "user",
   "text_redacted": "Wenn ich einen Lieferanten nicht kenne, frage ich immer erst den Controller, bevor ich irgendwas buche.",
   "lang": "de",
   "t_ms": 120000,
   "off_record": false
  },
  {
   "session_id": "00000000-0000-4000-8000-00000000d001",
   "turn_id": "tt-11",
   "role": "user",
   "text_redacted": "Ganz unter uns: der Einkauf ist bei Kranbau viel zu nachsichtig.",
   "lang": "de",
   "t_ms": 128000,
   "off_record": true
  },
  {
   "session_id": "00000000-0000-4000-8000-00000000d001",
   "turn_id": "tt-12",
   "role": "user",
   "text_redacted": "Und der Kollege aus dem Einkauf kriegt das auch nie mit.",
   "lang": "de",
   "t_ms": 133000,
   "off_record": false
  },
  {
   "session_id": "00000000-0000-4000-8000-00000000d001",
   "turn_id": "tt-13",
   "role": "user",
   "text_redacted": "So, das waren die drei.",
   "lang": "de",
   "t_ms": 142000,
   "off_record": false
  }
 ],
