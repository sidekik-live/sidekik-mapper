{"stream": "sk:transcript.turns", "envelope": {"id": "x", "type": "transcript.turn", "v": 1, "org_id": "00000000-0000-4000-8000-00000000a001", "session_id": "00000000-0000-4000-8000-00000000d001", "t_ms": 3500, "ts": "x", "producer": "gateway", "data": {"turn_id": "db-02", "role": "agent", "text": "Fragen Sie immer den Controller, bevor Sie einen unbekannten Lieferanten buchen?", "lang": "de", "source": "live", "redacted": true}}}
{"stream": "sk:transcript.turns", "envelope": {"id": "x", "type": "transcript.turn", "v": 1, "org_id": "00000000-0000-4000-8000-00000000a001", "session_id": "00000000-0000-4000-8000-00000000d001", "t_ms": 5500, "ts": "x", "producer": "gateway", "data": {"turn_id": "db-03", "role": "user", "text": "Ja, wenn ich einen Lieferanten nicht kenne, frage ich immer zuerst den Controller, bevor ich buche. Das sehe ich daran, dass er nicht in der Lieferantenliste steht.", "lang": "de", "source": "live", "redacted": true}}}
{"stream": "sk:transcript.turns", "envelope": {"id": "x", "type": "transcript.turn", "v": 1, "org_id": "00000000-0000-4000-8000-00000000a001", "session_id": "00000000-0000-4000-8000-00000000d001", "t_ms": 10000, "ts": "x", "producer": "gateway", "data": {"turn_id": "db-04", "role": "agent", "text": "Was machen Sie, wenn die Anlagennummer noch nicht vergeben ist?", "lang": "de", "source": "live", "redacted": true}}}
{"stream": "sk:transcript.turns", "envelope": {"id": "x", "type": "transcript.turn", "v": 1, "org_id": "00000000-0000-4000-8000-00000000a001", "session_id": "00000000-0000-4000-8000-00000000d001", "t_ms": 12000, "ts": "x", "producer": "gateway", "data": {"turn_id": "db-05", "role": "user", "text": "Dann lege ich zuerst eine Anlagennummer im Anlagenmodul an und buche erst danach.", "lang": "de", "source": "live", "redacted": true}}}
{"stream": "sk:transcript.turns", "envelope": {"id": "x", "type": "transcript.turn", "v": 1, "org_id": "00000000-0000-4000-8000-00000000a001", "session_id": "00000000-0000-4000-8000-00000000d001", "t_ms": 16500, "ts": "x", "producer": "gateway", "data": {"turn_id": "db-06", "role": "agent", "text": "Ab welchem Betrag braucht eine DE01-Rechnung eine zweite Freigabe?", "lang": "de", "source": "live", "redacted": true}}}
{"stream": "sk:transcript.turns", "envelope": {"id": "x", "type": "transcript.turn", "v": 1, "org_id": "00000000-0000-4000-8000-00000000a001", "session_id": "00000000-0000-4000-8000-00000000d001", "t_ms": 18500, "ts": "x", "producer": "gateway", "data": {"turn_id": "db-07", "role": "user", "text": "Ab 10.000 Euro netto brauchen wir in DE01 eine zweite Freigabe.", "lang": "de", "source": "live", "redacted": true}}}
{"stream": "sk:transcript.turns", "envelope": {"id": "x", "type": "transcript.turn", "v": 1, "org_id": "00000000-0000-4000-8000-00000000a001", "session_id": "00000000-0000-4000-8000-00000000d001", "t_ms": 23500, "ts": "x", "producer": "gateway", "data": {"turn_id": "db-08", "role": "agent", "text": "So machen Sie das: Sie öffnen die Rechnung, prüfen den Lieferanten … Habe ich das richtig verstanden?", "lang": "de", "source": "live", "redacted": true}}}
{"stream": "sk:transcript.turns", "envelope": {"id": "x", "type": "transcript.turn", "v": 1, "org_id": "00000000-0000-4000-8000-00000000a001", "session_id": "00000000-0000-4000-8000-00000000d001", "t_ms": 26000, "ts": "x", "producer": "gateway", "data": {"turn_id": "db-09", "role": "user", "text": "Nein, nicht ganz: Ausrüstung ist erst ab 10.000 Euro netto Capex, darunter bleibt es auf 4711.", "lang": "de", "source": "live", "redacted": true}}}
{"stream": "sk:transcript.turns", "envelope": {"id": "x", "type": "transcript.turn", "v": 1, "org_id": "00000000-0000-4000-8000-00000000a001", "session_id": "00000000-0000-4000-8000-00000000d001", "t_ms": 30500, "ts": "x", "producer": "gateway", "data": {"turn_id": "db-10", "role": "agent", "text": "Verstanden: Ausrüstung ist erst ab 10.000 Euro netto Capex. Stimmt das so?", "lang": "de", "source": "live", "redacted": true}}}
{"stream": "sk:transcript.turns", "envelope": {"id": "x", "type": "transcript.turn", "v": 1, "org_id": "00000000-0000-4000-8000-00000000a001", "session_id": "00000000-0000-4000-8000-00000000d001", "t_ms": 33000, "ts": "x", "producer": "gateway", "data": {"turn_id": "db-11", "role": "user", "text": "Ja, passt.", "lang": "de", "source": "live", "redacted": true}}}
