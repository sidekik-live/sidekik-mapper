{
  "name": "sidekik-mapper",
  "version": "0.1.0",
  "private": true,
  "description": "Sidekik Work Map builder: draft, debrief driver, guardrail compiler, publish, export, recall_context",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:mock": "tsx watch src/dev/mock.ts",
    "dev:replay": "tsx src/dev/replay.ts",
    "dev:draft": "tsx src/dev/draft.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@sidekik/contracts": "github:sidekik-live/sidekik-platform#v0.1.0",
    "@supabase/supabase-js": "^2",
    "fastify": "^5",
    "fastify-type-provider-zod": "^7.0.0",
    "fflate": "^0.8.3",
    "ioredis": "^6.0.0",
    "json-logic-js": "^2",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/json-logic-js": "^2.0.8",
    "@types/node": "^22.20.5",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3"
  }
}
